# Delivery settings (for research topic subscriptions)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LLM Provider: "ollama" (default, local) or "gemini" (Google AI Studio)
LLM_PROVIDER=ollama

# Required only when LLM_PROVIDER=gemini
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model defaults (only used when LLM_PROVIDER=gemini)
# Higher-quality tasks (analyst, writer, critic)
GEMINI_MODEL_QUALITY=gemini-2.5-flash
# Lighter tasks (planner, researcher, graph_builder)
GEMINI_MODEL_LITE=gemini-2.0-flash-lite
# Inter-agent delay in seconds to stay within free tier rate limits
GEMINI_DELAY_SECONDS=15

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2